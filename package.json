{
  "name": "multi-pokeidle-web",
  "version": "1.0.0",
  "description": "Mobile web interface for four isolated persistent PokeIdle sessions",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:backup": "node tools/backup-dist.js",
    "dist:backups": "node tools/backup-dist.js --listar",
    "dist:release": "electron-builder --win --publish never --config electron-builder.release.json",
    "test": "node test/run.js",
    "predist": "npm test && node tools/dev-release-info.js",
    "predist:release": "npm test",
    "postdist": "node tools/dev-release-info.js --remove",
    "web:start": "node web-mobile/server.js",
    "web:dev": "WEB_DEV=1 node web-mobile/server.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pokeidle.multi",
    "files": [
      "**/*",
      "!dist-release/**",
      "!test/**",
      "!build/**",
      "!tools/_x/**",
      "!.claude/**",
      "!dist/**",
      "!dist-backup/**",
      "!dist-fix/**",
      "!err.txt"
    ],
    "asarUnpack": [
      "extensions/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "es_ES"
      ],
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.56.1"
  }
}
